    "/run/start": {
      "post": {
        "summary": "连接本次1或20设备；连接调度不等于握手完成",
        "responses": {
          "200": {
            "description": "批次accepted/partial/rejected；含每个设备结果",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "run_id",
                    "status",
                    "attempted",
                    "accepted",
                    "rejected",
                    "results",
                    "note"
                  ],
                  "properties": {
                    "run_id": {
                      "type": "string"
                    },
                    "status": {
                      "enum": [
                        "accepted",
                        "partial",
                        "rejected"
                      ]
                    },
                    "attempted": {
                      "type": "integer"
                    },
                    "accepted": {
                      "type": "integer"
                    },
                    "rejected": {
                      "type": "integer"
                    },
                    "results": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "device_id": {
                            "type": "string"
                          },
                          "status": {
                            "enum": [
                              "accepted",
                              "rejected"
                            ]
                          },
                          "error": {
                            "type": "string"
                          }
                        }
                      }
                    },
                    "note": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "owner会话或CSRF无效"
          },
          "403": {
            "description": "Host或Origin不匹配"
          },
          "429": {
            "description": "本机请求速率超限"
          },
          "400": {
            "description": "JSON字段、编码或8KiB上限拒绝"
          },
          "409": {
            "description": "冲突、离线、范围、busy或动作拒绝"
          }
        },
        "security": [
          {
            "localOwner": [],
            "csrf": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Empty"
              }
            }
          }
        },
        "description": "逐设备连接准入；首错继续；accepted不是真实握手成功，随后查询state。"
      }
    },
