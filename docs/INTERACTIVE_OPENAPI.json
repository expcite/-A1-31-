{
  "openapi": "3.1.0",
  "info": {
    "title": "EdgeHybrid 本机交互 API",
    "version": "interactive-v1.2"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:{port}/api/v1",
      "variables": {
        "port": {
          "default": "0",
          "description": "启动窗口实际端口；0仅为CLI自动分配参数"
        }
      }
    }
  ],
  "security": [
    {
      "localOwner": []
    }
  ],
  "components": {
    "securitySchemes": {
      "localOwner": {
        "type": "apiKey",
        "in": "cookie",
        "name": "edgehybrid_owner"
      },
      "csrf": {
        "type": "apiKey",
        "in": "header",
        "name": "X-CSRF-Token"
      }
    },
    "schemas": {
      "Control": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "request_id",
          "device_id",
          "interval_ms"
        ],
        "properties": {
          "request_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "device_id": {
            "type": "string"
          },
          "interval_ms": {
            "type": "integer",
            "minimum": 100,
            "maximum": 60000
          }
        }
      },
      "Telemetry": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "request_id",
          "temperature_c"
        ],
        "properties": {
          "request_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "temperature_c": {
            "type": "number",
            "minimum": -50,
            "maximum": 150
          }
        }
      },
      "Empty": {
        "type": "object",
        "additionalProperties": false,
        "properties": {},
        "required": []
      },
      "Login": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          }
        },
        "required": [
          "code"
        ]
      },
      "Sampling": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "auto": {
            "type": "boolean"
          },
          "temperature_c": {
            "type": "number",
            "minimum": -50,
            "maximum": 150
          }
        },
        "required": [
          "auto",
          "temperature_c"
        ]
      },
      "Confirmation": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "confirm": {
            "type": "string"
          }
        },
        "required": [
          "confirm"
        ]
      },
      "Policy": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "confirm": {
            "type": "string"
          },
          "mode": {
            "type": "string",
            "enum": [
              "traditional",
              "hybrid"
            ]
          }
        },
        "required": [
          "confirm",
          "mode"
        ]
      },
      "Job": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "m6_rules",
              "bench_T",
              "bench_H",
              "pbench"
            ]
          }
        },
        "required": [
          "kind"
        ]
      },
      "Export": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "format": {
            "type": "string",
            "enum": [
              "json",
              "csv",
              "html"
            ]
          },
          "include_payload": {
            "type": "boolean",
            "default": false
          },
          "confirm": {
            "type": "string",
            "description": "仅include_payload=true时须为include_simulated_payload"
          },
          "selection": {
            "$ref": "#/components/schemas/EventSelection"
          }
        },
        "required": [
          "format"
        ]
      },
      "EventSelection": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "run_id",
          "from_event_id",
          "to_event_id"
        ],
        "properties": {
          "run_id": {
            "type": "string"
          },
          "from_event_id": {
            "type": "integer",
            "minimum": 0
          },
          "to_event_id": {
            "type": "integer",
            "minimum": 0
          },
          "device_id": {
            "type": "string",
            "maxLength": 128
          },
          "endpoint": {
            "type": "string",
            "maxLength": 128
          },
          "stage": {
            "type": "string",
            "maxLength": 128
          }
        }
      }
    }
  },
  "paths": {
    "/login": {
      "post": {
        "summary": "一次本机口令建立owner Cookie；精确Origin，5次/分钟",
        "responses": {
          "200": {
            "description": "实际响应；202只接受排队，确认须另观测"
          },
          "401": {
            "description": "owner会话或CSRF无效"
          },
          "403": {
            "description": "Host或Origin不匹配"
          },
          "429": {
            "description": "本机请求速率超限"
          },
          "400": {
            "description": "JSON字段、编码或8KiB上限拒绝"
          },
          "409": {
            "description": "冲突、离线、范围、busy或动作拒绝"
          }
        },
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Login"
              }
            }
          }
        }
      }
    },
    "/state": {
      "get": {
        "summary": "当前run快照",
